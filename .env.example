# =============================================================================
# HealthPulse AI - environment configuration template
# Copy to `.env` and adjust. Never commit real secrets.
# =============================================================================

# --- Application ---
APP_NAME=HealthPulse AI
ENVIRONMENT=development          # development | testing | production
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + PostGIS via docker-compose) ---
DATABASE_URL=postgresql+psycopg2://healthpulse:healthpulse@localhost:5432/healthpulse
# For a quick local run without PostgreSQL you can use SQLite:
# DATABASE_URL=sqlite:///./healthpulse.db

# --- Redis (optional; graceful no-op cache when unavailable) ---
REDIS_URL=redis://localhost:6379/0

# --- Document storage ---
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_UPLOAD_MB=20

# --- ML / NLP ---
# Sentence-Transformers model used when the optional ML extras are installed.
# With the offline fallback this is ignored (deterministic hashing embedder).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
COMPLAINT_CLASSIFIER_PATH=../ml/models/complaint_classifier/tfidf_lr.joblib
DEDUPE_THRESHOLD=0.75
ASSOCIATION_THRESHOLD=0.55
MAX_ASSOCIATION_KM=3.0
MAX_ASSOCIATION_DAYS=21

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
